# ==============================================================================
# REDhope Backend Environment Configuration (Example / Template)
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual credentials.
# In production platforms (Render, Railway, Heroku, AWS, DigitalOcean), configure
# these environment variables in your hosting provider's dashboard / secrets manager.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
# In production, use a dedicated production database user with readWrite privileges
# restricted to your production database (e.g. 'REDhope').
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=REDhope

# Authentication & Security
# Production JWT_SECRET MUST be a cryptographically secure string (min 32 chars).
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Comma-separated list of trusted client origins. In production, specify your exact domain(s).
# Example: https://redhope.org,https://www.redhope.org,https://app.redhope.org
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting
# Keep false in production. Can be set to true only in automated non-production test suites.
DISABLE_RATE_LIMIT=false

# Brevo Email Notification Service (Transactional)
# Required for sending donor reminders, camp confirmations, and emergency notifications.
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME=REDhope
EMAIL_NOTIFICATIONS_ENABLED=true

# Notification Scheduler (Cron)
# Set to 'false' if running multiple instances or separate worker dynos.
ENABLE_NOTIFICATION_SCHEDULER=true

# Private Medical Document Storage
# Path to local directory or persistent storage volume for sensitive donor health documents.
# Default: server/storage/medical_documents
MEDICAL_STORAGE_DIR=
