# ==============================================================================
# REDhope Frontend Environment Configuration (Example / Template)
# ==============================================================================
# In production, set this in your frontend hosting platform (e.g. Vercel, Netlify,
# Cloudflare Pages, Render) to point to your live backend API URL.
# NOTE: Variables prefixed with VITE_ are embedded into client JavaScript bundles.
# NEVER put private server secrets (database passwords, JWT secrets, API keys) here!
# ==============================================================================

# Public API Base URL for REDhope backend
# Development default: http://localhost:5000
# Production example: https://api.redhope.org
VITE_API_BASE_URL=http://localhost:5000
